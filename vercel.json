{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://openclip-api-santhosh.onrender.com/api/:path*"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://openclip-api-santhosh.onrender.com/docs/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://openclip-api-santhosh.onrender.com/docs"
    }
  ]
}
